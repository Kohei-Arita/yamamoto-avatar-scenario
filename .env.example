HOST=127.0.0.1
PORT=3000
LIVEAVATAR_API_KEY=
LIVEAVATAR_AVATAR_ID=3da5fea5-fdd9-4f5b-91e1-2d81aeb9aea2
LIVEAVATAR_VOICE_ID=1b205eb0-1010-4357-97cd-31fcfd80ee05
LIVEAVATAR_LANGUAGE=ja
LIVEAVATAR_MODE=FULL
LIVEAVATAR_USE_SANDBOX=false
LIVEAVATAR_VIDEO_QUALITY=medium
LIVEAVATAR_VIDEO_ENCODING=H264
LIVEAVATAR_SELF_CONTROLLED=true
LIVEAVATAR_VOICE_MODEL=eleven_multilingual_v2
LIVEAVATAR_VOICE_SPEED=0.9
LIVEAVATAR_VOICE_STABILITY=0.75
LIVEAVATAR_VOICE_SIMILARITY_BOOST=0.75
LIVEAVATAR_VOICE_STYLE=0.15
# false(既定): アバター発話中の患者音声を完全に無視し、必ず話し切らせる
# true: 患者の発話でアバターの発話を中断できる
LIVEAVATAR_ALLOW_INTERRUPT=false
LIVEAVATAR_ASSISTANT_NAME=山本
LIVEAVATAR_ASSISTANT_PERSONA=肺がん専門の内科医
# 空欄の場合はシナリオの entryNode のセリフが開始挨拶として使われる
LIVEAVATAR_OPENING_GREETING=
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# --- シナリオ進行 ---
SCENARIO_ID=haigan-2026
SCENARIO_DIR=./data/scenarios
# fixed: doctorLinesをそのまま読み上げ(本番推奨) / paraphrase: LLM言い換え(リハーサル用)
SCENARIO_SPEECH_MODE=fixed
# ルール不一致時にLLMでintent分類するか
SCENARIO_INTENT_LLM=true
# オペレーターAPI(/api/operator/*)のBearerトークン。必須
OPERATOR_TOKEN=

# --- 対話まわり ---
DIALOGUE_LOG_LIMIT=200
DIALOGUE_LLM_TRANSCRIPT_NORMALIZATION_ENABLED=false
DIALOGUE_LLM_TRANSCRIPT_NORMALIZATION_MODEL=gpt-4.1-mini
DIALOGUE_CONVERSATION_HISTORY_LIMIT=12
DIALOGUE_SESSION_LIMIT=200
