{
  "name": "yamamotoavator-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sandbox-ready HeyGen LiveAvatar demo for a professor avatar project.",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "ingest:haigan-2025": "node scripts/ingest-haigan-2025.mjs",
    "ingest:haigan-hybrid": "node scripts/ingest-haigan-hybrid.mjs",
    "validate:guidelines": "node scripts/validate-guideline-jsonl.mjs data/processed/lung-cancer-guideline-hybrid.jsonl",
    "provision:liveavatar-llm": "node scripts/provision-liveavatar-custom-llm.mjs",
    "inspect:liveavatar-llm": "node scripts/inspect-liveavatar-llm.mjs",
    "update:liveavatar-llm": "node scripts/update-liveavatar-llm.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "livekit-client": "^2.15.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.1.0",
    "globals": "^17.4.0",
    "prettier": "^3.8.1"
  }
}
